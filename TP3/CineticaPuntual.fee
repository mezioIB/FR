# TP 3 de Física de reactores, Cinética Puntual
# Cátedra de Física de Reactores: Aníbal Blanco, Roberto Maturana, Federico Mezio, Gustavo Saravia
# Input desarrollado por Héctor Lestani y Alexis Weir
# 
# Argumentos de entrada:
# 1: tipo de combustible: 1=U235 2=U233 3=Pu239
# 2: Reactividad para la cual se desean obtener el transitorio
# 3: tiempo de la simulación [s]
# 4: Cantidad de grupos de precursores, puede ser 1 ó 6
# 5: Vida media de los neutrones instantáneos [s]
# 
# Columnas de salida:
# 1: Tiempo [s]
# 2,3,4,5,6,7: Concentración de precursores
# 8: Población de neutrones


#************************************************************
# Implementación de los argumentos de entrada (no modificar)
#************************************************************
# Por defecto se elige U235 (tipo 1)
DEFAULT_ARGUMENT_VALUE 1 1
tipoCombustible = $1

# Por defecto se introduce una reactividad de 100[pcm]
DEFAULT_ARGUMENT_VALUE 2 100e-5
Rho = $2

# Por defecto se simulan 60[s]
DEFAULT_ARGUMENT_VALUE 3 60
end_time = $3

# Por defecto se usan 6 grupos de precursores
DEFAULT_ARGUMENT_VALUE 4 6
N = $4

# Por defecto se usa 100 microsegundos para la vida media de los n's prompt
DEFAULT_ARGUMENT_VALUE 5 1e-4
Lambda = $5


#************************************************************
# Otras variables que se pueden a modificar
#************************************************************
# Paso de tiempo de la simulación, en segundos.
delta_t = 0.1

# Condición inicial en n
n_0 = 1

# Condición inicial en Ci ("-1" implica concentraciones de equilibrio)
Cinicial = -1


#************************************************************
# Verificación que se eligió bien la cantidad de grupos de
# precursores
#************************************************************
IF not(N=1|N=6)
   PRINT "Error!! solo se pueden elegir 1 o 6 grupos de precursores, y elegiste $4"
   ABORT
ENDIF

#************************************************************
# Declaración de datos nucleares
#************************************************************
# Vida media precursores [1/s]
VECTOR lambdaU235  SIZE 6 DATA 0.01240 0.03050 0.11100 0.30100 1.14000 3.01000
VECTOR lambdaU233  SIZE 6 DATA 0.01260 0.03370 0.13900 0.32500 1.13000 2.50000
VECTOR lambdaPu239 SIZE 6 DATA 0.01280 0.03010 0.12400 0.32500 1.12000 2.69000 
# Fracción de neutrones retardados
VECTOR betaU235  SIZE 6 DATA 0.000215 0.001424 0.001274 0.002568 0.000748 0.000273
VECTOR betaU233  SIZE 6 DATA 0.00023  0.00080  0.00067  0.00074  0.00014  0.00009 
VECTOR betaPu239 SIZE 6 DATA 0.00007  0.00063  0.00045  0.00069  0.00018  0.00090 

IF step_transient=0
  VECTOR beta   SIZE 6    # vector donde se guarda la fracción de cada grupo de neutrones retardados
  VECTOR lambda SIZE 6    # vector donde se guarda la vida media de cada grupo de neutrones retardados
  
  # Asigno los betas y lambdas en función del tipo de combustible elegido
  IF tipoCombustible=1 #Entonces es U235
     # PRINT "Trabajando con U235"
     lambda[i] = lambdaU235[i]
     beta[i] = betaU235[i]
  ELSE
     IF tipoCombustible=2 #Entonces es U233
        # PRINT "Trabajando con U233"
        lambda[i] = lambdaU233[i]
        beta[i] = betaU233[i]
     ELSE
        IF tipoCombustible=3 #Entonces es Pu239
           # PRINT "Trabajando con Pu239"
           lambda[i] = lambdaPu239[i]
           beta[i] = betaPu239[i]
        ELSE
           PRINT "Error!! el tipo de combustible $1 no está en la lista"
           ABORT
        ENDIF
     ENDIF
  ENDIF

  Beta = sum(beta[i],i,1,6)
ENDIF

#************************************************************
# Ecuaciones de cinética puntual
#************************************************************

#**********
#  Si se corre a 1 grupo de precursores...
ENTRO = ENTRO * 1
IF N=1 
   IF ENTRO=0
      lambda[1] = Beta/(sum(beta[i]/lambda[i],i,1,6))
      beta[1] = Beta
      ENTRO = 1
   ENDIF
ENDIF
#**********


#**********
# Si la condición inicial en precursores es de equilibrio
VECTOR C SIZE N
IF Cinicial<0
   C_0[i] = n_0/Lambda*beta[i]/lambda[i]
ELSE
   C_0[i] = Cinicial
ENDIF
#**********

## Un poco de magia para evitar errores de integración
min_dt = 1e-15
max_dt = 1
rel_error = 1e-3
## Fin de la magia


#************************************************************
# Definición de las ecuaciones diferenciales a resolver
#************************************************************
PHASE_SPACE n C

# Ecuación para la población de neutrones
n_dot .= (Rho-Beta)/Lambda*n+sum(lambda[i]*C[i],i,1,N)

# Ecuación para la concentración de cada grupo de precursores
C_dot[i] .= beta[i]*n/Lambda-lambda[i]*C[i]

IF in_static
  IF N=1
    PRINT "\#t" "C" "n(t)"
  ELSE
    PRINT "\#t" "C1" "C2" "C3" "C4" "C5" "C6" "n(t)"
  ENDIF
ENDIF

PRINT t C  n
